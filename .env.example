# .env.example — template only. Copy to .env and fill in REAL values.
# NEVER commit .env or any real secrets. This file lists EVERY variable (no values).
# See docs/ENVIRONMENTS.md for the local/preview/production matrix, and
# docs/ARCHITECTURE.md "Conventions > Env": config is read via a Zod-validated
# env.ts module, and the app crashes at boot if a required variable is invalid.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server only. NEVER expose to the client / mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Auth ---
# Supabase Auth is the default. Add OAuth provider secrets here as needed, e.g.:
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Payments (optional, Stripe) ---
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# --- Email (optional, Resend) ---
RESEND_API_KEY=re_your-key-here

# --- Observability ---
SENTRY_DSN=https://your-key@sentry.io/your-project-id
POSTHOG_KEY=phc_your-key-here
POSTHOG_HOST=https://app.posthog.com

# --- AI / LLM gateway (optional) ---
LLM_API_KEY=your-llm-provider-key-here
